# ==========================================
# GitPulse Phone (PWA) Environment Variables
# ==========================================

# Default GitHub username to monitor (Fallback if not configured in the mobile app UI)
GITHUB_USERNAME=Andreyy05

# Optional: GitHub Personal Access Token (PAT)
# Recommended scopes: repo (read-only) or fine-grained read permissions.
# Benefits:
# - Increases GitHub API rate limit from 60 requests/hour to 5,000 requests/hour
# - Enables private repository streak calculation and push event tracking
GITHUB_TOKEN=
